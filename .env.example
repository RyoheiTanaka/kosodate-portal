# このファイルをコピーして .env を作る
#
#   cp .env.example .env
#
# .env と .env.* は gitignore 済み。値をこのファイルに書き戻さないこと。

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# 接続先は MONGODB_URI（DB名を含まない接続文字列）と MONGODB_DB（DB名）に分けている。
# dev/prod の切り替えは MONGODB_DB の1語だけで済み、接続文字列は編集しない。
# mongodump / mongorestore も DB名を含まない URI を要求するため、そのまま渡せる。
#
# 末尾が「/?」で始まっていること（DB名を入れない）。
#   例: mongodb+srv://kosodate-dev:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
#
# パスワードに @ / : ? # が含まれる場合は URL エンコードが必要（@ なら %40）。
MONGODB_URI=

# ローカル開発は必ず kosodate_dev。本番は kosodate（Vercel の環境変数側で設定する）。
MONGODB_DB=kosodate_dev

# 本番へデータを取り込むときは、その場限りで先頭に付けて実行する:
#
#   MONGODB_URI="<本番ユーザーの接続文字列>" MONGODB_DB=kosodate \
#     npm run import:nurseries -- --prod

# ---------------------------------------------------------------------------
# Google Maps（詳細ページの地図）
# ---------------------------------------------------------------------------
VITE_GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# reCAPTCHA（お問い合わせフォーム）
# ---------------------------------------------------------------------------
VITE_GOOGLE_RECAPTCHA_SITE_KEY=
GOOGLE_RECAPTCHA_SECRET_KEY=

# ---------------------------------------------------------------------------
# お問い合わせメールの送信（Gmail SMTP）
# ---------------------------------------------------------------------------
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
GMAIL_SMTP_USER=
GMAIL_SMTP_PASS=
GMAIL_SMTP_FROM=
